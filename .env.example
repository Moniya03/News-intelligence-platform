# ==============================================================================
# Multilingual News Intelligence Platform - Environment Configuration
# ==============================================================================

# OpenAI API Key for conversational RAG generation & citations (Model: gpt-6-luna)
# If left blank or invalid, RAG automatically uses deterministic offline citations fallback
OPENAI_API_KEY=your_openai_api_key_here

# (Optional fallback) Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection (matches infra/docker-compose.yml)
MONGO_URI=mongodb://localhost:27017

# Weaviate Vector Store (matches infra/docker-compose.yml)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
